{
  "$schema": "https://opencode.ai/config.json",
  // Default model for this project.
  "model": "opencode/deepseek-v4.1-flash-free",
  // Preserve the most recent context and compact with room to spare.
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000,
    },
    "buffer": 20000,
  },
  // Paths that should not trigger filesystem updates.
  "watcher": {
    "ignore": ["logs/**", ".git/**"],
  },
  //"providers": {
  //  "opencode": {
  //    "models": {
  //      "deepseek-v4.1-flash-free": {
          // Temperature is only honored when reasoning is off.
          // "capabilities": {
          //   "temperature": true,
          //   "reasoning": { "supported": false },
          // },
          // "settings": {
          //   "temperature": 0.1,
          // },
  //      },
//      },
//    },
//  },
  "permissions": [
    // Allow the run_slop tool without prompting.
    { "action": "run_slop", "resource": "*", "effect": "allow" },
    // Every other shell command needs approval...
    { "action": "shell", "resource": "*", "effect": "allow" },
    // ...except bootdev run commands, for this project only.
    { "action": "shell", "resource": "bootdev run *", "effect": "allow" },
    // Never launch the explore subagent in this project.
    { "action": "subagent", "resource": "explore", "effect": "deny" },
    // Ask before loading the example-writing skill.
    { "action": "skill", "resource": "create-test-program", "effect": "ask" },
    // Deny reading .secrets and .env files.
    { "action": "read", "resource": "*.secrets", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      // Kept configured but disconnected; remove "disabled" to reconnect.
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "disabled": true
      },
      // Bare "bunx" resolves through ~/.local/bin/bunx, which symlinks to
      // ~/.bun/bin/bun: ~/.bun/bin itself is not on the PATH inherited by the
      // OpenCode service (non-interactive shells skip the .bashrc export).
      // Disabled in favour of chrome-devtools; remove "disabled" to reconnect.
      "playwright": {
        "type": "local",
        "command": [
          "bunx",
          "--bun",
          "@playwright/mcp@0.0.80",
          "--isolated",
          "--browser",
          "chromium"
        ],
        "disabled": true
      },
      // -e points at Playwright's Chromium: the Chrome for Testing build that
      // chrome-devtools-mcp downloads by default (153) dies on launch here with
      // "Target closed". --headless keeps it off the WSLg desktop.
      "chrome-devtools": {
        "type": "local",
        "command": [
          "bunx",
          "--bun",
          "chrome-devtools-mcp@latest",
          "--isolated",
          "--headless",
          "-e",
          "/home/dida/.cache/ms-playwright/chromium-1243/chrome-linux64/chrome"
        ]
      }
    }
  },
}
